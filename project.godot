; Bedrock — addon dev/test project.
; Open this standalone to develop and test the base. Games consume addons/bedrock
; as a git submodule and enable the "Bedrock" plugin in their own project.

config_version=5

[application]

config/name="Bedrock"
config/description="Reusable modular base addon (save, identity, online multiplayer, shared services). Open standalone to develop; consumed by games as a submodule."
config/features=PackedStringArray("4.7")

[autoload]

CoreEvents="*res://addons/bedrock/api/event_bus.gd"
Platform="*res://addons/bedrock/api/platform_services.gd"
Identity="*res://addons/bedrock/api/identity_api.gd"
Save="*res://addons/bedrock/api/save_api.gd"
Net="*res://addons/bedrock/api/net_api.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/bedrock/plugin.cfg")
