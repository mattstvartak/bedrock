# Bedrock — EOS credentials template. Copy to .env and fill in. .env is gitignored.
# Values come from the Epic Dev Portal: Product Settings (product/sandbox/deployment)
# and a Client with credentials (client id/secret). Lock the Client Policy down to
# only what the game needs, since client creds ship inside the game binary.

EOS_PRODUCT_ID=
EOS_SANDBOX_ID=
EOS_DEPLOYMENT_ID=
EOS_CLIENT_ID=
EOS_CLIENT_SECRET=
