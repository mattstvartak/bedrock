# Bedrock secrets are managed in Doppler (project "bedrock", configs dev/stg/prd),
# not in a local .env. This file only documents which keys exist.
#
# Local dev/build inject them via `doppler run` (see scripts/ and doppler.yaml).
# Set or update a value with:  doppler secrets set KEY=value --config dev
#
# EOS (Epic Online Services) client config, baked into the game build.
# Lock the Client Policy down to only what the game needs, since client creds
# ship inside the game binary.
EOS_PRODUCT_ID=
EOS_SANDBOX_ID=
EOS_DEPLOYMENT_ID=
EOS_CLIENT_ID=
EOS_CLIENT_SECRET=

# Backend (Vercel) secrets, added when those services are provisioned:
# DATABASE_URL=            # Neon Postgres
# R2_ACCESS_KEY_ID=        # Cloudflare R2
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# JWT_SIGNING_KEY=         # signs the canonical-account sessions
