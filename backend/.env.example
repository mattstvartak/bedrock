# Bedrock backend env. Managed in Doppler (config bedrock/dev|stg|prd) and synced
# to Vercel, never committed. This file just documents the keys.

DATABASE_URL=            # Neon Postgres connection string
JWT_SIGNING_KEY=         # random 32+ byte secret that signs sessions

# BLOB_READ_WRITE_TOKEN is auto-injected by Vercel when a Blob store is connected
# to the project, so it's not set here.

STEAM_WEB_API_KEY=       # validates Steam session tickets (Steam logins); optional
STEAM_APP_ID=
